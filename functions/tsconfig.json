{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "CommonJS",
                            "moduleResolution":  "Node",
                            "rootDir":  "..",
                            "outDir":  "lib",
                            "esModuleInterop":  true,
                            "strict":  true,
                            "skipLibCheck":  true,
                            "noUnusedLocals":  true,
                            "noUnusedParameters":  true,
                            "ignoreDeprecations":  "6.0"
                        },
    "include":  [
                    "src/**/*.ts",
                    "../src/domain/**/*.ts",
                    "../src/config/firebase-functions.ts"
                ],
    "exclude":  [
                    "../src/**/*.test.ts",
                    "../src/**/*.test.tsx"
                ]
}